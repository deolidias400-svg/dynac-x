      { id: "aviao", title: "Jogo de Avião", cat: "arcade", desc: "Voo vertical, tiros, inimigos e combustível.", ready: false },
      { id: "pong", title: "Pong Finalizado", cat: "arcade", desc: "Jogador vs. IA com placar e controles.", ready: false },
      { id: "jokenpo", title: "Pedra, Papel e Tesoura", cat: "estrategia", desc: "Disputa até 5 pontos contra a IA.", ready: false },
      { id: "helicoptero", title: "Helicóptero Atração", cat: "cassino", desc: "Animação aérea com drone, hélices e luzes.", ready: false },
      { id: "caca-niqueis", title: "Caça-Níqueis Avançada", cat: "cassino", desc: "3 rolos com seletor de símbolo e botões.", ready: false },

      { id: "cidade-musical", title: "Cidade Musical", cat: "arcade", desc: "Defesa da cidade com canhão giratório.", ready: false },
      { id: "pacman", title: "Pacman / Labirinto Retrô", cat: "arcade", desc: "Labirinto clássico retrô.", ready: false },

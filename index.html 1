      { id: "xadrez", title: "Jogo de Xadrez", cat: "estrategia", desc: "Tabuleiro 8x8 com peças Unicode.", ready: false },
      { id: "jogo-da-velha", title: "Jogo da Velha", cat: "estrategia", desc: "Grade 3x3 contra a IA com placar.", ready: false },
      { id: "batalha-naval", title: "Batalha Naval", cat: "estrategia", desc: "Tabuleiros 10x10 jogador vs. IA.", ready: false },
      { id: "genius", title: "Jogo Genius", cat: "estrategia", desc: "Sequência de cores 2x2 e níveis.", ready: false },
      { id: "merlin", title: "Jogo Merlin Desafiante", cat: "estrategia", desc: "Grade 3x3 de memória com velocidade.", ready: false },
      { id: "misterio-veu-da-noite", title: "Mistério em Véu da Noite", cat: "estrategia", desc: "Investigação, pistas e acusação final.", ready: false }
    ];

    const DynacPortal = (() => {
      let currentId = null;
      let cleanups = [];
      let activeCat = "todos";
      let searchTerm = "";

      function runCleanups() {
        cleanups.forEach((fn) => { try { fn(); } catch (_) {} });
        cleanups = [];
      }

      function registerCleanup(fn) {
        cleanups.push(fn);
      }

      function renderCatalog() {
        const grid = document.getElementById("dx-grid");
        grid.innerHTML = "";
        const filtered = CATALOG_META.filter((item) => {
          const matchCat = activeCat === "todos" || item.cat === activeCat;
          const matchText = item.title.toLowerCase().includes(searchTerm.toLowerCase()) || item.desc.toLowerCase().includes(searchTerm.toLowerCase());
          return matchCat && matchText;
        });

        filtered.forEach((item) => {
          const card = document.createElement("article");
          card.className = "dx-card";
          card.innerHTML = `
            <div>
              <div class="dx-card-top">
                <span class="dx-badge">${item.cat.toUpperCase()}</span>
                <span class="dx-status-tag">${item.ready ? "PRONTO" : "PRÓXIMO BLOCO"}</span>
              </div>
              <h3>${item.title}</h3>
              <p>${item.desc}</p>
            </div>
            <button class="dx-btn ${item.ready ? "primary" : ""}" onclick="DynacPortal.openModule('${item.id}')">
              ${item.ready ? "Abrir Agora" : "Ver Status"}
            </button>`;
          grid.appendChild(card);
        });
      }

      function openModule(id) {
        runCleanups();
        currentId = id;
        const meta = CATALOG_META.find((m) => m.id === id);
        const mod = DYNAC_MODULES[id];
        const host = document.getElementById("dx-module-host");
        document.getElementById("dx-catalog-view").style.display = "none";
        document.getElementById("dx-stage-view").style.display = "block";
        document.getElementById("dx-stage-title").textContent = meta ? meta.title : id;
        host.innerHTML = "";

        if (mod && typeof mod.mount === "function") {
          mod.mount(host, registerCleanup);
        } else {
          host.innerHTML = `<div class="dx-pending-box"><h3>${meta ? meta.title : id}</h3><p>Este módulo será encaixado no próximo bloco do código único.</p></div>`;
        }
      }

      function restartCurrent() {
        if (currentId) openModule(currentId);
      }

      function showCatalog() {
        runCleanups();
        currentId = null;
        document.getElementById("dx-stage-view").style.display = "none";
        document.getElementById("dx-catalog-view").style.display = "block";
      }

      document.querySelectorAll(".dx-filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".dx-filter-btn").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          activeCat = btn.dataset.cat;
          renderCatalog();
        });
      });

      document.getElementById("dx-search").addEventListener("input", (e) => {
        searchTerm = e.target.value;
        renderCatalog();
      });

      renderCatalog();
      return { openModule, restartCurrent, showCatalog };
    })();
  </script>

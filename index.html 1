      { id: "bubble-shooter", title: "Bubble Shooter", cat: "arcade", desc: "Canhão e explosão de bolhas por cor.", ready: true },
      { id: "tenis", title: "Jogo de Tênis", cat: "arcade", desc: "Raquete solo com bola extra aos 10 pontos.", ready: true },
